generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  RESTAURANT_ADMIN
  RIDER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum TableBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id                String             @id @default(uuid())
  firebaseUid       String?            @unique // <-- Changed to Optional (?) for custom users
  password          String? // <-- Added for custom Email/Phone auth
  name              String?
  phone             String?            @unique
  email             String?            @unique
  role              Role               @default(CUSTOMER)
  address           String?
  gender            String? // MALE, FEMALE, OTHER
  dateOfBirth       DateTime?
  preferredLanguage String? // e.g., "en", "hi", "fr"
  preferredCuisines String[] // e.g., ["North Indian", "Chinese"]
  profilePictureUrl String?
  orders            Order[]
  tableBookings     TableBooking[]
  addresses         Address[]
  supportTickets    SupportTicket[]
  menuRatings       MenuRating[]
  isDeleted         Boolean  @default(false)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  favoriteMenuItems FavoriteMenuItem[]
  menuInteractions  MenuInteraction[]
}

model Address {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  label     String @default("Home")   // e.g., "Home", "Work"
  phone     String?
  receiverName String?
  landmark  String?
  userId    String
  street    String
  city      String
  state     String
  zipCode   String
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Restaurant {
  id             String         @id @default(uuid())
  name           String
  address        String
  lat            Float? // Added for Location & Radius API
  lng            Float? // Added for Location & Radius API
  rating         Float          @default(0.0)
  openingHours   String
  isPureVeg      Boolean        @default(false) // Added for Common Filters
  costForTwo     Int? // Added for Common Filters
  cuisines       String[] // Added for Common Filters (e.g., ["North Indian", "Chinese"])
  imageUrl       String? // Added for Restaurant Banners
  supportsDineIn Boolean        @default(false)
  dineInCapacity Int?
  menuItems      MenuItem[]
  orders         Order[]
  tableBookings  TableBooking[]
  adminId        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model MenuItem {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String

  name        String
  price       Float
  category    String
  isVeg       Boolean @default(true)
  imageUrl    String?
  isAvailable Boolean @default(true)

  orderCount    Int   @default(0)
  favoriteCount Int   @default(0)
  averageRating Float @default(0)
  totalRatings  Int   @default(0)

  ratings    MenuRating[]
  isFeatured Boolean      @default(false)

  orderItems OrderItem[]

  createdAt         DateTime           @default(now())
  favoriteMenuItems FavoriteMenuItem[]
  menuInteractions  MenuInteraction[]
}

model DeliveryPartner {
  id           String   @id @default(uuid())
  userId       String   @unique
  vehicleType  String
  locationLat  Float?
  locationLng  Float?
  availability Boolean  @default(false)
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Order {
  id                   String               @id @default(uuid())
  user                 User                 @relation(fields: [userId], references: [id])
  userId               String
  restaurant           Restaurant           @relation(fields: [restaurantId], references: [id])
  restaurantId         String
  deliveryPartner      DeliveryPartner?     @relation(fields: [deliveryPartnerId], references: [id])
  deliveryPartnerId    String?
  status               OrderStatus          @default(PENDING)
  totalAmount          Float
  deliveryAddress      String
  items                OrderItem[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  orderStatusHistories OrderStatusHistory[]
}

model OrderItem {
  id                 String   @id @default(uuid())
  order              Order    @relation(fields: [orderId], references: [id])
  orderId            String
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId         String
  quantity           Int
  priceAtTimeOfOrder Float
}

model Banner {
  id         String   @id @default(uuid())
  bannerName String   @default("veg-banner")
  imageUrl   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  imageUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TableBooking {
  id              String             @id @default(uuid())
  user            User               @relation(fields: [userId], references: [id])
  userId          String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id])
  restaurantId    String
  bookingDateTime DateTime
  partySize       Int
  specialRequest  String?
  status          TableBookingStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([restaurantId, bookingDateTime])
  @@index([userId, createdAt])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  subject String
  message String

  status SupportTicketStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FavoriteMenuItem {
  id String @id @default(uuid())

  userId     String
  menuItemId String

  user     User     @relation(fields: [userId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, menuItemId])
}

enum InteractionType {
  VIEW
  ADD_TO_CART
  ORDER
  FAVORITE
}

model MenuInteraction {
  id String @id @default(uuid())

  userId     String
  menuItemId String

  interaction InteractionType

  createdAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model MenuRating {
  id String @id @default(uuid())

  rating Int
  review String?

  userId     String
  menuItemId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, menuItemId])
}

model OrderStatusHistory {
  id String @id @default(uuid())

  orderId String

  status OrderStatus

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
